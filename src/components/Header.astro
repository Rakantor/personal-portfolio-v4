---
import { Menu } from '@lucide/astro';
import { localeLabels, localePath, localizedPathFor, type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
	showLanguageSwitcher?: boolean;
};

const { locale = 'en', showLanguageSwitcher = true } = Astro.props;
const t = ui[locale];

const languageLinks = [
	{ locale: 'en' as const, href: localizedPathFor(Astro.url.pathname, 'en'), label: 'EN' },
	{ locale: 'de' as const, href: localizedPathFor(Astro.url.pathname, 'de'), label: 'DE' },
];

const navItems = [
	{ label: t.nav.home, href: localePath(locale, '/#home') },
	{ label: t.nav.projects, href: localePath(locale, '/#projects') },
	{ label: t.nav.stack, href: localePath(locale, '/#stack') },
];
---

<header class="sticky top-0 z-40 border-b border-base-300 bg-base-100/90 backdrop-blur-xl">
	<div class="navbar shell min-h-0 px-0">
		<div class="navbar-start">
			<a
				class="flex items-center gap-2.5 font-display text-[0.95rem] font-bold tracking-tight"
				href={localePath(locale, '/#home')}
				aria-label="Manuel Veigel — home"
			>
				<svg class="h-[30px] w-[30px] shrink-0 text-navy" viewBox="0 0 40 40" fill="none" aria-hidden="true">
					<rect x="1.5" y="1.5" width="37" height="37" rx="8" stroke="currentColor" stroke-width="3"></rect>
					<path d="M10 28V12h3.5l6.5 9.4 6.5-9.4H30v16h-3.5V18.7l-5.3 7.4h-2.4l-5.3-7.4V28H10Z" fill="currentColor"></path>
				</svg>
				<span class="max-sm:sr-only">Manuel Veigel</span>
			</a>
		</div>

		<nav class="navbar-center hidden gap-9 lg:flex" aria-label={t.nav.home}>
			{navItems.map((item) => <a class="nav-link" href={item.href}>{item.label}</a>)}
		</nav>

		<div class="navbar-end gap-1">
			{
				showLanguageSwitcher && (
					<div class="hidden items-center gap-0.5 font-mono text-[0.78rem] text-muted-2 lg:flex" aria-label={t.nav.language}>
						{languageLinks.map((item, index) => (
							<>
								<a
									class:list={[
										'btn btn-ghost btn-sm min-h-10 px-2.5 font-mono text-[0.78rem]',
										item.locale === locale ? 'font-bold text-base-content' : 'font-normal text-muted',
									]}
									href={item.href}
									aria-current={item.locale === locale ? 'page' : undefined}
									aria-label={localeLabels[item.locale]}
								>
									{item.label}
								</a>
								{index === 0 && <span class="text-base-300" aria-hidden="true">·</span>}
							</>
						))}
					</div>
				)
			}

			<div class="dropdown dropdown-end lg:hidden">
				<button class="btn btn-ghost btn-square" type="button" aria-label={t.nav.open}>
					<Menu size={22} />
				</button>
				<ul class="menu dropdown-content z-50 mt-3 w-52 gap-1 rounded-box border border-base-300 bg-base-200 p-2 shadow-lg">
					{
						navItems.map((item) => (
							<li>
								<a class="font-mono text-[0.8rem] uppercase tracking-wider" href={item.href}>
									{item.label}
								</a>
							</li>
						))
					}
					{
						showLanguageSwitcher && (
							<li class="mt-1 border-t border-base-300 pt-1">
								<div class="flex items-center gap-1 font-mono text-[0.8rem]">
									{languageLinks.map((item, index) => (
										<>
											<a
												class:list={[
													'px-2 py-1',
													item.locale === locale ? 'font-bold text-primary' : 'text-muted',
												]}
												href={item.href}
												aria-current={item.locale === locale ? 'page' : undefined}
												aria-label={localeLabels[item.locale]}
											>
												{item.label}
											</a>
											{index === 0 && <span class="text-base-300" aria-hidden="true">·</span>}
										</>
									))}
								</div>
							</li>
						)
					}
				</ul>
			</div>
		</div>
	</div>
</header>
