---
import { Terminal } from '@lucide/astro';
---

<div class="section-shell py-2" aria-hidden="true">
	<div class="flex items-center gap-4 text-slate-300">
		<div class="h-px flex-1 bg-gradient-to-r from-transparent via-slate-300 to-slate-200"></div>
		<div class="flex items-center gap-2 rounded-full border border-slate-200 bg-white px-4 py-2 font-mono text-xs text-slate-500 shadow-sm shadow-slate-200/70">
			<Terminal class="text-primary" size={16} />
			<span class="text-slate-400">const</span>
			<span class="text-slate-700">work</span>
			<span class="text-slate-400">=</span>
			<span class="text-primary">buildUsefulThings()</span>
		</div>
		<div class="h-px flex-1 bg-gradient-to-r from-slate-200 via-slate-300 to-transparent"></div>
	</div>
</div>
