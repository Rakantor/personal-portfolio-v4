---
import { ArrowRight } from '@lucide/astro';
import { getImage } from 'astro:assets';
import QuickLinkIcon from './QuickLinkIcon.astro';
import { getQuickLink, type Project, type QuickLinkSlot } from '../data/projects';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	project: Project;
	locale?: Locale;
	/** The quick-link columns, shared by all rows. */
	slots: QuickLinkSlot[];
	isLast?: boolean;
};

const { project, locale = 'en', slots, isLast = false } = Astro.props;
const t = ui[locale];
const href = localePath(locale, `/projects/${project.slug}`);
const slotColumns = `grid-template-columns: repeat(${slots.length}, minmax(0, 1fr))`;

// Shown at 144 to 176px wide in a 16:10 crop.
const shot = await getImage({ src: project.image, width: 400, height: 250, format: 'webp', quality: 75 });
---

<div
	data-reveal
	class:list={[
		'index-row rule-top grid items-center gap-5 px-2 py-5 transition-colors hover:bg-white/5 lg:grid-cols-[9rem_minmax(0,1fr)_10rem] lg:gap-7',
		isLast && 'rule-bottom',
	]}
>
	<span class="shot max-lg:max-w-[11rem]">
		<img src={shot.src} alt="" width={400} height={250} loading="lazy" decoding="async" />
	</span>

	<div>
		<div class="tag-line mb-2">
			{project.tags.map((tag) => <span>{t.projects.tags[tag]}</span>)}
		</div>

		<a
			class="index-row-link inline-flex items-center gap-2 font-display text-[1.15rem] font-semibold tracking-tight text-white transition-colors hover:text-blue-bright"
			href={href}
		>
			{project.title}
			<ArrowRight class="go text-blue-bright" size={15} />
		</a>

		<p class="prose-serif mt-1.5 max-w-[52ch] text-[0.95rem] text-white/65">
			{project.shortDescription}
		</p>

		<div class="tech-line mt-2.5">
			{project.tech.map((tech) => <span>{tech}</span>)}
		</div>
	</div>

	<!-- Fixed columns on lg, under the headings in Projects.astro. Below that
	     the links pack to the left. -->
	<div class="flex flex-wrap gap-2 lg:grid" style={slotColumns}>
		{
			slots.map((type) => {
				const button = getQuickLink(project, type);

				if (!button) {
					return <span class="hidden h-10 lg:block" aria-hidden="true" />;
				}

				// Icon by column, label by button type.
				const label = t.projects.buttons[button.type];

				return (
					<a
						class="btn btn-outline btn-sm btn-on-dark h-10 min-h-10 w-10 px-0 lg:w-full"
						href={button.href}
						target="_blank"
						rel="noreferrer"
						aria-label={`${label}: ${project.title}`}
						title={`${label}: ${project.title}`}
					>
						<QuickLinkIcon type={type} size={17} />
						<span class="sr-only">{label}</span>
					</a>
				);
			})
		}
	</div>
</div>
