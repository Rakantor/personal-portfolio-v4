---
import { Mail } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import { type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="mt-12 border-t border-slate-800 bg-slate-800 text-white">
	<div class="section-shell grid gap-3 py-4 md:grid-cols-3 md:items-center">
		<p class="text-center text-sm text-white md:text-left">© {currentYear} Manuel Veigel. {t.footer.rights}</p>

		<div class="flex items-center justify-center gap-3">
			<a class="btn btn-ghost btn-circle text-white hover:bg-white/10 hover:text-white" href="https://github.com/Rakantor" aria-label="GitHub">
				<svg aria-hidden="true" class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor">
					<path d={siGithub.path}></path>
				</svg>
			</a>
			<a class="btn btn-ghost btn-circle text-white hover:bg-white/10 hover:text-white" href="mailto:maveigel@gmail.com" aria-label="Email">
				<Mail size={20} />
			</a>
		</div>

		<div class="flex justify-center md:justify-end">
			<a class="px-2 text-sm font-medium text-white hover:text-white" href="/impressum">
				{t.footer.legal}
			</a>
		</div>
	</div>
</footer>
