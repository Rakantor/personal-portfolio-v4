---
import { Mail } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import { type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const currentYear = new Date().getFullYear();
---

<footer id="contact" class="bg-neutral text-neutral-content/70">
	<div class="shell flex flex-col items-center justify-between gap-5 py-9 text-center font-mono text-[0.76rem] tracking-wide md:flex-row md:text-left">
		<p class="m-0">© {currentYear} Manuel Veigel</p>

		<div class="flex gap-1">
			<a class="btn btn-ghost btn-circle text-white hover:bg-white/10" href="https://github.com/Rakantor" aria-label="GitHub">
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
					<path d={siGithub.path}></path>
				</svg>
			</a>
			<a class="btn btn-ghost btn-circle text-white hover:bg-white/10" href="mailto:maveigel@gmail.com" aria-label="Email">
				<Mail size={19} />
			</a>
		</div>

		<a class="transition-colors hover:text-white" href="/impressum">{t.footer.legal}</a>
	</div>
</footer>
