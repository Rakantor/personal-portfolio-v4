---
import { ArrowLeft, ArrowRight } from '@lucide/astro';
import { getImage } from 'astro:assets';
import Footer from './Footer.astro';
import Header from './Header.astro';
import QuickLinkIcon from './QuickLinkIcon.astro';
import Layout from '../layouts/Layout.astro';
import { getLocalizedProject, getProjectButtonLabel, projects, type Project } from '../data/projects';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	project: Project;
	locale: Locale;
};

const { project, locale } = Astro.props;
const t = ui[locale];

const currentIndex = projects.findIndex((candidate) => candidate.slug === project.slug);
const nextProject = getLocalizedProject(projects[(currentIndex + 1) % projects.length], locale);

const hasGallery = project.images.length > 1;
const totalLabel = String(project.images.length).padStart(2, '0');
const isExternal = (href: string) => href.startsWith('http');

/*
 * The screenshots are CloudFront originals of up to ~1900px. The frame is
 * ~500px wide and the thumbnails 96px, so both are re-encoded at build time to
 * something proportionate. Slides keep each image's own ratio — the frame is
 * still sized by the first one — while thumbnails are cropped to the 16:10 the
 * strip renders them at. Sharp will not upscale, so screenshots already smaller
 * than the target come through untouched.
 */
const FRAME_WIDTH = 1000;
const THUMB_WIDTH = 192;

/** `src` is a required attribute, so deferred slides hold a transparent pixel until shown. */
const BLANK_PIXEL = 'data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7';

const gallery = await Promise.all(
	project.images.map(async (image) => {
		const [slide, thumb] = await Promise.all([
			getImage({
				src: image.src,
				width: FRAME_WIDTH,
				height: Math.round((FRAME_WIDTH * image.height) / image.width),
				format: 'webp',
				quality: 78,
			}),
			getImage({
				src: image.src,
				width: THUMB_WIDTH,
				height: Math.round((THUMB_WIDTH * 10) / 16),
				format: 'webp',
				quality: 70,
			}),
		]);

		return { alt: image.alt, width: image.width, height: image.height, slide: slide.src, thumb: thumb.src };
	})
);
---

<!-- shortDescription, not description: the long one runs to ~490 characters,
     well past what search results and social cards keep. -->
<Layout locale={locale} title={project.title} description={project.shortDescription}>
	<Header locale={locale} />

	<main id="content" class="shell">
		<nav class="flex items-center gap-2 pt-9 font-mono text-[0.75rem] uppercase tracking-[0.08em] text-muted-2">
			<a
				class="inline-flex items-center gap-1.5 transition-colors hover:text-primary"
				href={localePath(locale, '/#projects')}
			>
				<ArrowLeft size={14} />
				{t.nav.projects}
			</a>
			<span class="text-base-300" aria-hidden="true">/</span>
			<span class="text-base-content">{project.title}</span>
		</nav>

		<div class="pb-10 pt-11">
			<h1 class="h-hero max-w-[16ch] text-[clamp(2.4rem,5.4vw,4.1rem)] text-navy">{project.title}</h1>
		</div>

		<!-- Description alongside the gallery, 40 / 60 -------------------- -->
		<!-- 40% description / 10% gutter / 50% gallery. Explicit tracks plus
		     space-between: the 10% left over lands entirely in the gutter. -->
		<div class="grid items-start gap-10 lg:grid-cols-[40%_50%] lg:justify-between lg:gap-x-0">
			<p class="prose-serif m-0 min-w-0 text-[1.08rem] text-[#333c4d]">{project.description}</p>

			<!-- min-w-0: without it the scrolling thumbnail strip stretches the column. -->
			<div
				class:list={['grid min-w-0 gap-3', hasGallery && 'lg:grid-cols-[minmax(0,1fr)_5.25rem]']}
				data-gallery
			>
				<div class="relative overflow-hidden rounded-[3px] bg-navy shadow-[0_30px_70px_-40px_rgb(12_23_48/0.6)]">
					<!-- No fixed aspect ratio: the first screenshot sets the frame height and the
					     rest are contained inside it. Within a project the shots share nearly the
					     same ratio, so this removes the letterboxing a fixed frame would cause.
					     Its intrinsic size is declared so the box is reserved up front — without
					     it the frame started at zero height and shoved the article down on load. -->
					<img
						data-slide="0"
						class="block h-auto w-full opacity-100 transition-opacity duration-300"
						src={gallery[0].slide}
						alt={gallery[0].alt}
						width={gallery[0].width}
						height={gallery[0].height}
						loading="eager"
						fetchpriority="high"
					/>

					<!-- These sit inside the visible frame, so `loading="lazy"` would never
					     defer them. Holding the URL back until a slide is first shown does. -->
					{
						gallery.slice(1).map((image, offset) => (
							<img
								data-slide={offset + 1}
								class="pointer-events-none absolute inset-0 h-full w-full object-contain opacity-0 transition-opacity duration-300"
								src={BLANK_PIXEL}
								data-src={image.slide}
								alt={image.alt}
								width={image.width}
								height={image.height}
								loading="lazy"
							/>
						))
					}

					{
						hasGallery && (
							<>
								<button
									class="btn btn-circle absolute left-4 top-1/2 -translate-y-1/2 border-0 bg-white/90 text-navy hover:bg-white"
									type="button"
									data-gallery-step="-1"
									aria-label={t.projectDetail.previousImage}
								>
									<ArrowLeft size={20} />
								</button>
								<button
									class="btn btn-circle absolute right-4 top-1/2 -translate-y-1/2 border-0 bg-white/90 text-navy hover:bg-white"
									type="button"
									data-gallery-step="1"
									aria-label={t.projectDetail.nextImage}
								>
									<ArrowRight size={20} />
								</button>

								<span
									class="absolute bottom-4 right-4 rounded-[2px] bg-navy/80 px-2.5 py-1.5 font-mono text-[0.72rem] tracking-wider text-white backdrop-blur"
									aria-live="polite"
								>
									<span data-gallery-current>01</span> / {totalLabel}
								</span>
							</>
						)
					}
				</div>

				<!-- Thumbnails: horizontal strip on narrow screens, vertical rail beside the
				     image on desktop. The inner absolute layer lets the rail scroll within
				     the image's height rather than stretching the row. -->
				{
					hasGallery && (
						<div class="relative min-h-0 min-w-0">
							<div class="flex gap-2.5 overflow-x-auto pb-1 lg:absolute lg:inset-0 lg:flex-col lg:overflow-x-hidden lg:overflow-y-auto lg:pb-0">
								{gallery.map((image, index) => (
									<button
										type="button"
										data-gallery-target={index}
										class:list={[
											'block w-24 shrink-0 overflow-hidden rounded-[2px] border bg-base-200 transition lg:w-full',
											index === 0
												? 'border-primary opacity-100 ring-2 ring-primary/25'
												: 'border-base-300 opacity-55 hover:opacity-100',
										]}
										aria-label={`${t.projectDetail.goToImage} ${index + 1}`}
										aria-current={index === 0 ? 'true' : undefined}
									>
										<img
											class="aspect-[16/10] w-full object-cover"
											src={image.thumb}
											alt=""
											width={192}
											height={120}
											loading="lazy"
											decoding="async"
										/>
									</button>
								))}
							</div>
						</div>
					)
				}
			</div>
		</div>

		<!-- Sticky meta rail + article ----------------------------------- -->
		<div class="rule-top mt-18 grid gap-20 pt-13 lg:grid-cols-[17rem_minmax(0,1fr)]">
			<aside class="self-start lg:sticky lg:top-24">
				<div class="pb-5">
					<h2 class="mb-3 font-mono text-[0.68rem] uppercase tracking-[0.15em] text-muted-2">
						{t.projectDetail.tech}
					</h2>
					<div class="flex flex-col gap-1.5 font-mono text-[0.82rem]">
						{project.tech.map((tech) => <span>{tech}</span>)}
					</div>
				</div>

				<div class="rule-top pt-5">
					<h2 class="mb-3 font-mono text-[0.68rem] uppercase tracking-[0.15em] text-muted-2">
						{t.projectDetail.links}
					</h2>
					<div class="flex flex-col gap-2">
						{
							project.buttons.map((button) => (
								<a
									class="btn btn-neutral btn-sm min-h-11 justify-center"
									href={button.href}
									target={isExternal(button.href) ? '_blank' : undefined}
									rel={isExternal(button.href) ? 'noreferrer' : undefined}
									aria-label={button.aria ?? `${getProjectButtonLabel(button.type, locale)}: ${project.title}`}
								>
									<QuickLinkIcon type={button.type} />
									{getProjectButtonLabel(button.type, locale)}
								</a>
							))
						}
					</div>
				</div>
			</aside>

			<div>
				<section class="rule-bottom mb-13 pb-13">
					<h2 class="mb-5 font-display text-[1.35rem] font-bold tracking-tight text-navy">
						{t.projectDetail.overview}
					</h2>
					<div class="prose-serif max-w-[68ch] text-[1.08rem] text-[#333c4d]">
						{project.overview.map((paragraph) => <p class="mb-4 last:mb-0">{paragraph}</p>)}
					</div>
				</section>

				<section class="rule-bottom mb-13 pb-13">
					<h2 class="mb-5 font-display text-[1.35rem] font-bold tracking-tight text-navy">
						{t.projectDetail.features}
					</h2>
					<ul class="m-0 list-none p-0">
						{
							project.features.map((feature, index) => (
								<li
									class:list={[
										'grid grid-cols-[2.6rem_minmax(0,1fr)] gap-2 py-3.5',
										index > 0 && 'border-t border-dashed border-base-300',
									]}
								>
									<span class="pt-1 font-mono text-[0.75rem] tracking-wider text-primary" aria-hidden="true">
										{String(index + 1).padStart(2, '0')}
									</span>
									<span class="prose-serif text-[1.05rem] text-[#333c4d]">{feature}</span>
								</li>
							))
						}
					</ul>
				</section>

				<section>
					<h2 class="mb-5 font-display text-[1.35rem] font-bold tracking-tight text-navy">
						{t.projectDetail.learned}
					</h2>
					<p class="prose-serif max-w-[68ch] text-[1.08rem] text-[#333c4d]">{project.learned}</p>
				</section>
			</div>
		</div>

		<a
			class="group rule-top rule-bottom mt-20 flex items-center justify-between gap-8 py-11"
			href={localePath(locale, `/projects/${nextProject.slug}`)}
		>
			<div>
				<span class="font-mono text-[0.7rem] uppercase tracking-[0.16em] text-muted-2">
					{t.projectDetail.next}
				</span>
				<div class="mt-2 font-display text-[clamp(1.5rem,3vw,2.15rem)] font-bold tracking-tight text-navy transition-colors group-hover:text-primary">
					{nextProject.title}
				</div>
			</div>
			<ArrowRight class="shrink-0 text-primary transition-transform group-hover:translate-x-1" size={28} />
		</a>
	</main>

	<div class="mt-20"></div>
	<Footer locale={locale} />

	<script>
		document.querySelectorAll('[data-gallery]').forEach((gallery) => {
			const slides = Array.from(gallery.querySelectorAll('[data-slide]'));
			const thumbs = Array.from(gallery.querySelectorAll('[data-gallery-target]'));
			const counter = gallery.querySelector('[data-gallery-current]');
			if (slides.length < 2) return;

			let active = 0;

			// Slides carry their URL in data-src until first shown. Neighbours are
			// resolved alongside so stepping through the gallery never waits.
			const load = (index) => {
				const slide = slides[(index + slides.length) % slides.length];
				const src = slide?.getAttribute('data-src');
				if (!src) return;
				slide.setAttribute('src', src);
				slide.removeAttribute('data-src');
			};

			const show = (next) => {
				const index = (next + slides.length) % slides.length;
				load(index);
				load(index + 1);
				load(index - 1);
				if (index === active) return;
				active = index;

				slides.forEach((slide, i) => {
					const isActive = i === index;
					slide.classList.toggle('opacity-100', isActive);
					slide.classList.toggle('opacity-0', !isActive);
					slide.classList.toggle('pointer-events-none', !isActive);
				});

				thumbs.forEach((thumb, i) => {
					const isActive = i === index;
					thumb.classList.toggle('border-primary', isActive);
					thumb.classList.toggle('opacity-100', isActive);
					thumb.classList.toggle('ring-2', isActive);
					thumb.classList.toggle('ring-primary/25', isActive);
					thumb.classList.toggle('border-base-300', !isActive);
					thumb.classList.toggle('opacity-55', !isActive);
					thumb.classList.toggle('hover:opacity-100', !isActive);

					if (isActive) {
						thumb.setAttribute('aria-current', 'true');
					} else {
						thumb.removeAttribute('aria-current');
					}
				});

				if (counter) counter.textContent = String(index + 1).padStart(2, '0');
			};

			gallery.addEventListener('click', (event) => {
				if (!(event.target instanceof Element)) return;

				const step = event.target.closest('[data-gallery-step]');
				if (step) {
					show(active + Number(step.getAttribute('data-gallery-step')));
					return;
				}

				const target = event.target.closest('[data-gallery-target]');
				if (target) show(Number(target.getAttribute('data-gallery-target')));
			});

			// Hovering a thumbnail previews it, same as clicking. Guarded to real mice so
			// touch devices don't fire a synthesised hover before the tap registers.
			gallery.addEventListener('pointerover', (event) => {
				if (event.pointerType !== 'mouse') return;
				if (!(event.target instanceof Element)) return;

				const target = event.target.closest('[data-gallery-target]');
				if (target) show(Number(target.getAttribute('data-gallery-target')));
			});

			gallery.addEventListener('keydown', (event) => {
				if (event.key === 'ArrowLeft') {
					show(active - 1);
				} else if (event.key === 'ArrowRight') {
					show(active + 1);
				} else {
					return;
				}
				event.preventDefault();
			});
		});
	</script>
</Layout>
