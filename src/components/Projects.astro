---
import ProjectCard from './ProjectCard.astro';
import { getLocalizedProjects } from '../data/projects';
import { type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const projects = getLocalizedProjects(locale);
---

<section id="projects" class="section-shell py-10">
	<div class="mb-6 flex items-end justify-between gap-6">
		<div>
			<h2 class="text-3xl font-bold tracking-normal text-slate-950">{t.projects.title}</h2>
		</div>
	</div>

	<div class="grid gap-7 md:grid-cols-2">
		{projects.map((project) => <ProjectCard project={project} locale={locale} />)}
	</div>
</section>
