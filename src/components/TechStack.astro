---
import SkillIcon from './SkillIcon.astro';
import { skillGroups, toolGroups } from '../data/skills';
import { type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];
const currentYear = new Date().getFullYear();

const yearsLabel = (since: number) => {
	const years = currentYear - since;
	if (years < 1) return t.techStack.yearLess;
	return years === 1 ? t.techStack.yearOne : t.techStack.yearsMany.replace('{n}', String(years));
};

// 0 means "too many to count" (see Skill.projects), shown as "> 10" to match
// the "< 1 year" of the years label.
const projectsLabel = (count: number) => {
	if (count === 1) return t.techStack.projectOne;
	return t.techStack.projectsMany.replace('{n}', count === 0 ? '> 10' : String(count));
};

// Strongest first within each group, so the list reads as a ranking.
const groups = skillGroups.map((group) => ({
	...group,
	skills: [...group.skills].sort((a, b) => b.level - a.level || a.since - b.since),
}));
---

<section id="stack" class="shell pt-20 pb-24">
	<h2 data-reveal class="eyebrow mb-6"><span class="num">04</span> {t.techStack.title}</h2>

	<div class="stack-groups mt-12">
		{
			groups.map((group) => (
				<div data-reveal class="stack-group">
					<h3 class="stack-group-title">{t.techStack.groups[group.key]}</h3>
					<ul class="skill-list">
						{group.skills.map((skill, row) => {
							const levelLabel = t.techStack.levels[skill.level];
							return (
								<li class="skill" style={`--r: ${row}`}>
									<SkillIcon icon={skill.icon} />
									<span class="skill-name">{skill.name}</span>
									<span class="skill-level">{levelLabel}</span>
									<span class="meter" role="img" aria-label={`${levelLabel}, ${skill.level}/5`}>
										{[1, 2, 3, 4, 5].map((step) => (
											<i class:list={[step <= skill.level && 'on']} style={`--s: ${step - 1}`} />
										))}
									</span>
									<span class="skill-meta">
										<span>{yearsLabel(skill.since)}</span>
										<span>{projectsLabel(skill.projects)}</span>
									</span>
								</li>
							);
						})}
					</ul>
				</div>
			))
		}
	</div>

	<!-- Platforms and tools, in the same columns as the skills but without a
	     rating: for these, whether I use them matters more than how well. -->
	<div data-reveal class="tools-groups mt-16">
		{
			toolGroups.map((group) => (
				<div>
					<h3 class="stack-group-title">{t.techStack.groups[group.key]}</h3>
					<ul class="skill-list tool-list">
						{group.tools.map((tool) => (
							<li class="tool">
								<SkillIcon icon={tool.icon} />
								<span>{tool.name}</span>
							</li>
						))}
					</ul>
				</div>
			))
		}
	</div>
</section>


<style>
	.stack-groups {
		display: grid;
		gap: 3rem 4rem;
	}

	@media (min-width: 1024px) {
		.stack-groups {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	.stack-group-title {
		margin-bottom: 0.9rem;
		font-family: var(--font-mono);
		font-size: 0.73rem;
		font-weight: 500;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	/* One rule under the group title; the skills themselves are separated by
	   spacing alone. */
	.skill-list {
		border-top: 1px solid var(--color-rule);
	}

	/* icon | name ........ level
	   icon | ■■■■□ meter .......
	   icon | years   projects    */
	.skill {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr) auto;
		grid-template-areas:
			'icon name  level'
			'icon meter meter'
			'icon meta  meta';
		column-gap: 0.9rem;
		row-gap: 0.4rem;
		align-items: center;
		padding-block: 1.1rem;
	}

	/* The icon renders in a child component, so it needs :global to be reached. */
	.skill :global(svg) {
		grid-area: icon;
		align-self: start;
		width: 2.25rem;
		height: 2.25rem;
		margin-top: 0.1rem;
	}

	.skill-name {
		grid-area: name;
		font-family: var(--font-display);
		font-size: 1.15rem;
		font-weight: 600;
		letter-spacing: -0.01em;
		color: var(--color-navy);
	}

	.skill-level {
		grid-area: level;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--color-primary);
	}

	/* Five discrete steps rather than a percentage bar: a rating this coarse
	   shouldn't pretend to the precision of "78%". */
	.meter {
		grid-area: meter;
		display: grid;
		grid-template-columns: repeat(5, minmax(0, 1fr));
		gap: 3px;
	}

	.meter i {
		height: 6px;
		background: var(--color-rule);
	}

	.meter i.on {
		background: var(--color-primary);
	}

	.tools-groups {
		display: grid;
		gap: 3rem 4rem;
	}

	@media (min-width: 1024px) {
		.tools-groups {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}

	/* Names only, so two to a row. */
	.tool-list {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 2rem;
	}

	.tool {
		display: flex;
		align-items: center;
		gap: 0.9rem;
		padding-block: 0.8rem;
		font-family: var(--font-display);
		font-size: 1.05rem;
		font-weight: 600;
		color: var(--color-navy);
	}

	.tool :global(svg) {
		width: 1.6rem;
		height: 1.6rem;
		flex: 0 0 auto;
	}

	.skill-meta {
		grid-area: meta;
		display: flex;
		gap: 1.25rem;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		color: var(--color-muted-2);
	}
</style>
