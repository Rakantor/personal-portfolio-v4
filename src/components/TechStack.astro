---
import { Boxes, CodeXml, Database, Globe, MonitorSmartphone, Route } from '@lucide/astro';
import { skillGroups } from '../data/skills';
import { type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];

const capabilities = [
	{ label: t.techStack.capabilities.fullStack, Icon: CodeXml },
	{ label: t.techStack.capabilities.objectOriented, Icon: Boxes },
	{ label: t.techStack.capabilities.restApis, Icon: Route },
	{ label: t.techStack.capabilities.databaseDesign, Icon: Database },
	{ label: t.techStack.capabilities.crossPlatform, Icon: MonitorSmartphone },
	{ label: t.techStack.capabilities.deploymentHosting, Icon: Globe },
];

const isMulticolorIcon = (icon: (typeof skillGroups)[number]['skills'][number]['icon']) => 'paths' in icon;
---

<section id="stack" class="shell py-20">
	<h2 class="eyebrow mb-8"><span class="num">03</span> {t.techStack.capabilities.title}</h2>

	<ul class="grid list-none grid-cols-1 gap-0 p-0 sm:grid-cols-2 lg:grid-cols-3">
		{
			capabilities.map(({ label, Icon }) => (
				<li class="rule-top flex items-center gap-4 py-5 pr-6 text-base font-medium">
					<Icon class="shrink-0 text-primary" size={22} aria-hidden="true" />
					<span>{label}</span>
				</li>
			))
		}
	</ul>
</section>

<section id="tech-stack" class="shell pb-24">
	<h2 class="eyebrow mb-8"><span class="num">04</span> {t.techStack.title}</h2>

	{
		skillGroups.map((group, index) => (
			<div
				class:list={[
					'rule-top grid items-start gap-4 py-6 lg:grid-cols-[10rem_minmax(0,1fr)] lg:gap-8',
					index === skillGroups.length - 1 && 'rule-bottom',
				]}
			>
				<h3 class="pt-2 font-mono text-[0.73rem] font-medium uppercase tracking-[0.14em] text-muted">
					{t.techStack.groups[group.key]}
				</h3>

				<div class="tile-grid">
					{group.skills.map((skill) => (
						<span class="tile">
							{
								isMulticolorIcon(skill.icon) ? (
									<svg viewBox={skill.icon.viewBox} aria-hidden="true">
										{skill.icon.paths.map((path) => (
											<path d={path.d} fill={path.fill} />
										))}
									</svg>
								) : (
									<svg viewBox="0 0 24 24" fill={`#${skill.icon.hex}`} aria-hidden="true">
										<path d={skill.icon.path} />
									</svg>
								)
							}
							<span>{skill.name}</span>
						</span>
					))}
				</div>
			</div>
		))
	}
</section>
