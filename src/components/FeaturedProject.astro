---
import { ArrowRight } from '@lucide/astro';
import { getImage } from 'astro:assets';
import QuickLinkIcon from './QuickLinkIcon.astro';
import { getProjectButtonLabel, type Project } from '../data/projects';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	project: Project;
	locale?: Locale;
	/** Even indexes put the screenshot on the left, odd ones on the right. */
	index?: number;
	isFirst?: boolean;
	isLast?: boolean;
};

const { project, locale = 'en', index = 0, isFirst = false, isLast = false } = Astro.props;
const t = ui[locale];
const href = localePath(locale, `/projects/${project.slug}`);

// .shot crops to 16:10 anyway, so the build emits exactly that rather than a
// ~1900px original scaled down in the browser. ~600px on screen, doubled for
// high-density displays.
const shot = await getImage({ src: project.image, width: 1200, height: 750, format: 'webp', quality: 78 });
---

<article
	class:list={[
		'specimen grid items-center gap-13 py-13 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]',
		!isFirst && 'rule-top',
		isFirst && 'pt-0',
		isLast && 'pb-0',
	]}
>
	<a
		class:list={['shot', index % 2 === 1 && 'lg:order-2']}
		href={href}
		tabindex="-1"
		aria-hidden="true"
	>
		<img src={shot.src} alt="" width={1200} height={750} loading="lazy" decoding="async" />
	</a>

	<div>
		<h3 class="h-project text-navy">
			<a class="transition-colors hover:text-primary" href={href}>{project.title}</a>
		</h3>

		<p class="prose-serif mb-6 mt-4 max-w-[46ch] text-[1.05rem] text-[#3c4557]">
			{project.shortDescription}
		</p>

		<div class="tech-line">
			{project.tech.map((tech) => <span>{tech}</span>)}
		</div>

		<div class="mt-7 flex flex-wrap gap-2">
			<a class="btn btn-neutral btn-sm min-h-10" href={href}>
				{t.projects.readMore}
				<ArrowRight size={16} />
			</a>

			{
				project.buttons.map((button) => (
					<a
						class="btn btn-outline btn-sm min-h-10 border-base-300 bg-base-200 font-semibold text-muted hover:border-primary hover:bg-base-200 hover:text-primary"
						href={button.href}
						target="_blank"
						rel="noreferrer"
						aria-label={button.aria ?? `${getProjectButtonLabel(button.type, locale)}: ${project.title}`}
					>
						<QuickLinkIcon type={button.type} />
						{getProjectButtonLabel(button.type, locale)}
					</a>
				))
			}
		</div>
	</div>
</article>
