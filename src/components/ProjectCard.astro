---
import { ExternalLink, FileText, Globe2 } from '@lucide/astro';
import type { Project } from '../data/projects';

type Props = {
	project: Project;
};

const { project } = Astro.props;
const visibleTech = project.tech.slice(0, 4);
const hiddenTechCount = project.tech.length - visibleTech.length;
---

<article class="card soft-card h-full overflow-hidden rounded-lg transition duration-200 hover:-translate-y-1 hover:shadow-xl">
	<figure class="relative aspect-[16/9] overflow-hidden bg-slate-100">
		<img class="h-full w-full object-cover" src={project.image} alt={`${project.title} screenshot`} loading="lazy" />
	</figure>

	<div class="card-body p-5">
		<div>
			<p class="text-xs font-semibold uppercase tracking-[0.12em] text-primary">{project.subtitle}</p>
			<h3 class="card-title mt-2 text-xl text-slate-950">{project.title}</h3>
			<p class="project-description mt-3 text-sm leading-6 text-slate-600">{project.description}</p>
		</div>

		<div class="mt-4 flex flex-wrap gap-2">
			{
				visibleTech.map((tech) => (
					<span class="badge border-slate-200 bg-slate-50 px-3 py-3 text-xs font-medium text-slate-600">
						{tech}
					</span>
				))
			}
			{
				hiddenTechCount > 0 && (
					<span class="badge border-blue-100 bg-blue-50 px-3 py-3 text-xs font-medium text-primary">
						+{hiddenTechCount}
					</span>
				)
			}
		</div>

		<div class="card-actions mt-auto pt-5">
			{
				project.buttons.map((button) => (
					<a
						class="btn btn-sm min-h-9 rounded-lg border-slate-300 bg-white text-slate-700 hover:border-primary hover:bg-blue-50 hover:text-primary"
						href={button.href}
						aria-label={button.aria ?? `${button.label}: ${project.title}`}
						target="_blank"
						rel="noreferrer"
					>
						{button.type === 'website' && <Globe2 size={15} />}
						{button.type === 'pdf' && <FileText size={15} />}
						{
							button.type === 'github' && (
								<svg aria-hidden="true" class="h-[15px] w-[15px]" viewBox="0 0 24 24" fill="currentColor">
									<path d="M12 2C6.48 2 2 6.58 2 12.26c0 4.54 2.87 8.39 6.84 9.75.5.09.68-.22.68-.49 0-.24-.01-1.04-.01-1.89-2.78.62-3.37-1.21-3.37-1.21-.45-1.19-1.11-1.51-1.11-1.51-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.89 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.08 0-1.12.39-2.04 1.03-2.76-.1-.26-.45-1.31.1-2.72 0 0 .84-.28 2.75 1.05A9.35 9.35 0 0 1 12 6.96c.85 0 1.7.12 2.5.34 1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.46.1 2.72.64.72 1.03 1.64 1.03 2.76 0 3.95-2.34 4.82-4.57 5.08.36.32.68.94.68 1.9 0 1.38-.01 2.49-.01 2.81 0 .27.18.59.69.49A10.13 10.13 0 0 0 22 12.26C22 6.58 17.52 2 12 2Z"></path>
								</svg>
							)
						}
						<span>{button.label}</span>
						<ExternalLink size={14} />
					</a>
				))
			}
		</div>
	</div>
</article>
