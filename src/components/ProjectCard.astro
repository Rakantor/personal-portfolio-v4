---
import { ArrowRight, Earth, Play, FileText } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import { getProjectButtonLabel, type Project } from '../data/projects';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	project: Project;
	locale?: Locale;
};

const { project, locale = 'en' } = Astro.props;
const t = ui[locale];
const projectHref = localePath(locale, `/projects/${project.slug}`);
const getButtonClass = (type: Project['buttons'][number]['type']) =>
	`btn h-10 min-h-10 min-w-32 flex-1 rounded-lg px-3 text-sm font-semibold shadow-none ${
		type === 'github'
			? 'border-slate-950 bg-slate-950 text-white hover:border-black hover:bg-black hover:text-white'
			: 'btn-primary text-white'
	}`;
---

<article class="card soft-card h-full overflow-hidden rounded-lg transition duration-200 hover:shadow-xl">
	<figure class="relative aspect-[16/9] overflow-hidden bg-slate-100 after:pointer-events-none after:absolute after:inset-0 after:border after:border-[var(--soft-card-border)]">
		<a class="block h-full w-full" href={projectHref} aria-label={`${t.projects.viewDetails} ${project.title}`}>
			<img class="h-full w-full object-cover transition duration-200 hover:scale-[1.02]" src={project.image} alt={`${project.title} ${t.projects.imageAlt}`} loading="lazy" />
		</a>
	</figure>

	<div class="card-body p-5">
		<div>
			<h3 class="card-title text-xl text-slate-950">
				<a class="hover:text-primary" href={projectHref}>{project.title}</a>
			</h3>
			<p class="project-description mt-3 text-sm leading-6 text-slate-600">{project.shortDescription}</p>
			<a class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-[#315fc7]" href={projectHref}>
				{t.projects.readMore}
				<ArrowRight size={15} />
			</a>
		</div>

		<div class="mt-4 flex flex-wrap gap-2">
			{
				project.tech.map((tech) => (
					<span class="badge border-[var(--soft-card-border)] bg-transparent px-3 py-3 text-xs font-medium text-slate-600">
						{tech}
					</span>
				))
			}
		</div>

		<div class="card-actions mt-auto flex flex-row flex-wrap items-center justify-end gap-2 border-t border-slate-100 pt-4">
			{
				project.buttons.map((button) => (
					<a
						class={getButtonClass(button.type)}
						href={button.href}
						aria-label={button.aria ?? `${getProjectButtonLabel(button.type, locale)}: ${project.title}`}
						target="_blank"
						rel="noreferrer"
					>
						{button.type === 'website' && <Earth size={18} />}
						{button.type === 'demo' && <Play size={18} />}
						{button.type === 'pdf' && <FileText size={18} />}
						{
							button.type === 'github' && (
								<svg aria-hidden="true" class="h-[18px] w-[18px]" viewBox="0 0 24 24" fill="currentColor">
									<path d={siGithub.path}></path>
								</svg>
							)
						}
						<span>{getProjectButtonLabel(button.type, locale)}</span>
					</a>
				))
			}
		</div>
	</div>
</article>
