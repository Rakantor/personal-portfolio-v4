---
import { ArrowRight, FileText, Globe2 } from '@lucide/astro';
import { siGithub } from 'simple-icons';
import type { Project } from '../data/projects';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	project: Project;
	locale?: Locale;
};

const { project, locale = 'en' } = Astro.props;
const t = ui[locale];
const projectHref = localePath(locale, `/projects/${project.slug}`);
---

<article class="card soft-card h-full overflow-hidden rounded-lg transition duration-200 hover:shadow-xl">
	<figure class="relative aspect-[16/9] overflow-hidden bg-slate-100">
		<a class="block h-full w-full" href={projectHref} aria-label={`${t.projects.viewDetails} ${project.title}`}>
			<img class="h-full w-full object-cover transition duration-200 hover:scale-[1.02]" src={project.image} alt={`${project.title} ${t.projects.imageAlt}`} loading="lazy" />
		</a>
	</figure>

	<div class="card-body p-5">
		<div>
			<h3 class="card-title text-xl text-slate-950">
				<a class="hover:text-primary" href={projectHref}>{project.title}</a>
			</h3>
			<p class="project-description mt-3 text-sm leading-6 text-slate-600">{project.description}</p>
			<a class="mt-2 inline-flex items-center gap-1 text-sm font-semibold text-primary hover:text-blue-700" href={projectHref}>
				{t.projects.readMore}
				<ArrowRight size={15} />
			</a>
		</div>

		<div class="mt-4 flex flex-wrap gap-2">
			{
				project.tech.map((tech) => (
					<span class="badge border-blue-100 bg-blue-50 px-3 py-3 text-xs font-medium text-blue-800">
						{tech}
					</span>
				))
			}
		</div>

		<div class="card-actions mt-auto flex flex-row items-center gap-2 pt-5">
			{
				project.buttons.map((button) => (
					<a
						class="grid h-9 w-9 shrink-0 place-items-center rounded-full text-slate-700 transition hover:bg-blue-50 hover:text-primary"
						href={button.href}
						aria-label={button.aria ?? `${button.label}: ${project.title}`}
						target="_blank"
						rel="noreferrer"
					>
						{button.type === 'website' && <Globe2 size={22} />}
						{button.type === 'pdf' && <FileText size={22} />}
						{
							button.type === 'github' && (
								<svg aria-hidden="true" class="h-[22px] w-[22px]" viewBox="0 0 24 24" fill="currentColor">
									<path d={siGithub.path}></path>
								</svg>
							)
						}
					</a>
				))
			}
		</div>
	</div>
</article>
