---
import { ArrowRight, Code2, Mail } from '@lucide/astro';
import avatar from '../assets/avatar.webp';
---

<section id="home" class="section-shell grid min-h-[620px] items-center gap-12 py-16 lg:grid-cols-[1fr_0.9fr] lg:py-20">
	<div class="max-w-2xl">
		<h1 class="text-5xl font-extrabold leading-tight tracking-normal text-slate-950 sm:text-6xl lg:text-7xl">
			Hey, I'm Manuel.
		</h1>
		<p class="mt-6 max-w-xl text-lg leading-8 text-slate-600">
			I'm a Software Developer based in Vienna, Austria. I love building things that people enjoy using and that impact their lives in a positive way.
		</p>

		<div class="mt-8 flex flex-wrap gap-4">
			<a class="btn btn-primary min-h-12 rounded-lg px-5 text-white shadow-lg shadow-blue-600/20" href="#projects">
				View Projects
				<ArrowRight size={18} />
			</a>
			<a class="btn min-h-12 rounded-lg border-slate-300 bg-white px-5 text-slate-900 hover:border-primary hover:bg-blue-50" href="mailto:maveigel@gmail.com">
				Contact
				<Mail size={18} />
			</a>
		</div>
	</div>

	<div class="relative mx-auto grid w-full max-w-[31rem] place-items-center py-10">
		<div class="absolute right-0 top-8 h-72 w-72 rounded-full bg-blue-100/80 blur-2xl"></div>
		<div class="absolute right-16 top-2 grid grid-cols-5 gap-3 opacity-50" aria-hidden="true">
			{Array.from({ length: 25 }).map(() => <span class="h-1 w-1 rounded-full bg-blue-400"></span>)}
		</div>
		<div class="relative w-[min(82vw,25rem)]">
			<img
				class="h-auto w-full drop-shadow-2xl"
				src={avatar.src}
				width={avatar.width}
				height={avatar.height}
				alt="Portrait illustration of Manuel"
				fetchpriority="high"
			/>
		</div>
		<div class="soft-card absolute bottom-3 left-0 hidden w-48 rounded-lg p-5 sm:block">
			<Code2 class="text-primary" size={30} />
			<p class="mt-4 text-sm leading-6 text-slate-600">
				Clean code.<br />
				Thoughtful design.<br />
				Useful experiences.
			</p>
		</div>
	</div>
</section>
