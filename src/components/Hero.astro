---
import { ArrowRight } from '@lucide/astro';
import avatar from '../assets/avatar.webp';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];
---

<!-- Fixed-width avatar column rather than a fraction: the greeting is short, so a
     proportional split left a large hole between the text and the portrait. -->
<section id="home" class="shell grid items-center gap-10 py-20 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-14">
	<div>
		<h1 class="h-hero text-navy">
			<span class="block">{t.hero.titleTop}</span>
			<span class="block">{t.hero.titleBottom}</span>
		</h1>

		<p class="prose-serif mt-8 max-w-[50ch] text-[1.125rem] text-[#333c4d]">
			{t.hero.description}
		</p>

		<div class="mt-10 flex flex-wrap gap-3">
			<a class="btn btn-neutral" href={localePath(locale, '/#projects')}>
				{t.hero.projects}
				<ArrowRight size={17} />
			</a>
			<a
				class="btn btn-outline border-base-300 hover:border-neutral hover:bg-base-200 hover:text-base-content"
				href="mailto:maveigel@gmail.com"
			>
				{t.hero.contact}
			</a>
		</div>
	</div>

	<figure class="m-0 w-full justify-self-end max-lg:order-first max-lg:w-[min(70%,17rem)] max-lg:justify-self-center">
		<img
			class="h-auto w-full"
			src={avatar.src}
			width={avatar.width}
			height={avatar.height}
			alt={t.hero.avatarAlt}
			fetchpriority="high"
		/>
	</figure>
</section>
