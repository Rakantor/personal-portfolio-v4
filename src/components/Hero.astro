---
import { ArrowDown } from '@lucide/astro';
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.webp';
import Backdrop from './Backdrop.astro';
import { localePath, type Locale, ui } from '../i18n';

type Props = {
	locale?: Locale;
};

const { locale = 'en' } = Astro.props;
const t = ui[locale];

---

<div class="relative isolate">
	<Backdrop interactive />
	<!-- relative keeps the section above the backdrop (see Backdrop.astro). -->
	<section id="home" class="hero-grid shell relative grid items-center gap-10 py-16">
		<div>
			<h1 class="hero-title h-hero text-navy">
				<span class="hero-line block" style="--i: 0">{t.hero.titleTop}</span>
				<span class="hero-line block" style="--i: 1">{t.hero.titleBottom}</span>
			</h1>

			<p class="hero-in prose-serif mt-8 max-w-[50ch] text-[1.125rem] text-[#333c4d]" style="--i: 2">
				{t.hero.description}
			</p>

			<div class="hero-in mt-10 flex flex-wrap gap-3" style="--i: 3">
				<a class="btn btn-neutral" href={localePath(locale, '/#projects')}>
					{t.hero.projects}
					<ArrowDown class="hero-arrow" size={17} />
				</a>
				<a
					class="btn btn-outline border-base-300 bg-base-100 hover:border-neutral hover:bg-base-200 hover:text-base-content"
					href="#contact"
				>
					{t.hero.contact}
				</a>
			</div>
		</div>

		<figure
			class="hero-figure m-0 w-full justify-self-end max-lg:order-first max-lg:w-[min(70%,17rem)] max-lg:justify-self-center"
		>
			<!-- Never wider than 512px on screen; the source is 1254px. -->
			<Image
				class="h-auto w-full"
				src={avatar}
				widths={[272, 416, 544, 832, 1024]}
				sizes="(min-width: 1024px) 32rem, min(70vw, 17rem)"
				alt={t.hero.avatarAlt}
				loading="eager"
				fetchpriority="high"
			/>
		</figure>
	</section>
</div>

<style>
	/* Fills the viewport below the 61px header (60px navbar + 1px border).
	   svh, so mobile browser chrome doesn't cover the bottom. */
	.hero-grid {
		min-height: calc(100svh - 61px);
		align-content: center;
	}

	@media (min-width: 1024px) {
		.hero-grid {
			grid-template-columns: minmax(0, 1fr) 32rem;
			column-gap: 3rem;
		}
	}

	.hero-title {
		font-size: clamp(3.2rem, 8.4vw, 7.6rem);
	}

	/* Bobbing arrow on the projects button, after the hero entrance. Under the
	   global reduced-motion rule it would flicker, hence the media query. */
	@media (prefers-reduced-motion: no-preference) {
		:global(.hero-arrow) {
			animation: hero-arrow-float 1.6s ease-in-out 1.4s infinite alternate;
		}
	}

	@keyframes hero-arrow-float {
		from {
			transform: translateY(-1.5px);
		}
		to {
			transform: translateY(2.5px);
		}
	}
</style>
