---
import { ArrowRight } from '@lucide/astro';
import Backdrop from '../components/Backdrop.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Layout from '../layouts/Layout.astro';
import { localePath, ui } from '../i18n';

// GitHub Pages serves this page for every missing path, including those under
// /de, so it shows both languages.
const en = ui.en.notFound;
const de = ui.de.notFound;
---

<Layout locale="en" translated={false} noindex title={en.title} description={en.description}>
	<!-- The language switcher would link to the missing path in the other language. -->
	<Header locale="en" showLanguageSwitcher={false} />

	<main id="content" class="relative isolate flex flex-col">
		<Backdrop />
		<div class="shell relative flex min-h-[60vh] flex-1 flex-col justify-center py-20">
			<p class="font-mono text-[0.74rem] uppercase tracking-[0.16em] text-primary">{en.eyebrow}</p>

			<h1 class="h-hero mt-5 max-w-[18ch] text-navy">{en.heading}</h1>

			<p class="prose-serif mt-7 max-w-[52ch] text-[1.08rem] text-[#333c4d]">{en.description}</p>

			<div class="mt-10 flex flex-wrap gap-3">
				<a class="btn btn-neutral" href={localePath('en', '/')}>
					{en.home}
					<ArrowRight size={17} />
				</a>
			</div>

			<p class="rule-top mt-14 max-w-[52ch] pt-7 text-[0.95rem] text-muted" lang="de">
				{de.heading}{' '}
				<a class="font-semibold text-primary underline underline-offset-4" href={localePath('de', '/')}>
					{de.home}
				</a>
			</p>
		</div>
	</main>

	<Footer locale="en" />
</Layout>
