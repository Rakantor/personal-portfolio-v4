---
import '../styles/global.css';
import Reveal from '../components/Reveal.astro';
import { defaultLocale, htmlLang, localePath, locales, stripLocaleFromPathname, ui, type Locale } from '../i18n';

type Props = {
	title?: string;
	description?: string;
	locale?: Locale;
	/** False for pages that exist in one language only. */
	translated?: boolean;
	/** For the 404 page, which GitHub Pages also serves at /404/ with a 200. */
	noindex?: boolean;
};

const {
	title = 'Manuel Veigel | Software Developer',
	description = 'Portfolio of Manuel Veigel, a software developer building clean and useful digital products.',
	locale = defaultLocale,
	translated = true,
	noindex = false,
} = Astro.props;

const t = ui[locale];

// GitHub Pages redirects /path to /path/, so the canonical and alternate URLs
// carry the trailing slash.
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

const normalizedPath = withTrailingSlash(Astro.url.pathname);
const canonical = new URL(normalizedPath, Astro.site);

const alternateFor = (alternateLocale: Locale) =>
	new URL(withTrailingSlash(localePath(alternateLocale, stripLocaleFromPathname(normalizedPath))), Astro.site).href;

const alternates = translated
	? locales.map((alternateLocale) => ({ locale: alternateLocale, href: alternateFor(alternateLocale) }))
	: [];

// This page's path per locale, for the language redirect below. Paths, not
// URLs, so it also works on localhost.
const localePaths = Object.fromEntries(
	locales.map((pathLocale) => [pathLocale, withTrailingSlash(localePath(pathLocale, stripLocaleFromPathname(normalizedPath)))]),
);

// public/og.jpg is rendered from scripts/og/og.html and checked in. Regenerate
// it when the avatar or the name/role on it change.
const ogImageUrl = new URL('/og.jpg', Astro.site);
const ogImageSize = { width: 1200, height: 630 };

const ogLocales: Record<Locale, string> = { en: 'en_US', de: 'de_AT' };
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="portfolio">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!--
			Language redirect. GitHub Pages can't negotiate it, so on arrival from
			outside the site this switches to the browser's language. A language
			picked in the header (localStorage) takes precedence.
		-->
		{
			translated && (
				<script is:inline define:vars={{ locale, localePaths }}>
					try {
						const cameFromSite = document.referrer && new URL(document.referrer).origin === location.origin;
						if (!cameFromSite) {
							const chosen = localStorage.getItem('locale');
							const preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
								.map((language) => language.toLowerCase().split('-')[0])
								.find((language) => language in localePaths);
							const wanted = chosen in localePaths ? chosen : preferred === 'de' ? 'de' : 'en';
							if (wanted !== locale) location.replace(localePaths[wanted] + location.search + location.hash);
						}
					} catch {
						// localStorage or the referrer may be unavailable. Stay put.
					}
				</script>
			)
		}

		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f4f6f9" />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonical.href} />
		{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
		{translated && <link rel="alternate" hreflang="x-default" href={alternateFor(defaultLocale)} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Manuel Veigel" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:image:width" content={String(ogImageSize.width)} />
		<meta property="og:image:height" content={String(ogImageSize.height)} />
		<meta property="og:image:alt" content={t.meta.ogImageAlt} />
		<meta property="og:locale" content={ogLocales[locale]} />
		{
			locales
				.filter((alternateLocale) => translated && alternateLocale !== locale)
				.map((alternateLocale) => <meta property="og:locale:alternate" content={ogLocales[alternateLocale]} />)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl.href} />

		<link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-serif-4-var-latin.woff2" as="font" type="font/woff2" crossorigin />

		<title>{title}</title>

		<!-- The entrance animations in global.css only hide elements under html.js,
		     so the content stays visible without JavaScript. -->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body class="bg-base-100 text-base-content">
		<a class="skip-link" href="#content">{t.nav.skip}</a>
		<slot />
		<Reveal />
	</body>
</html>
