---
import '../styles/global.css';
import Reveal from '../components/Reveal.astro';
import { defaultLocale, htmlLang, localePath, locales, stripLocaleFromPathname, ui, type Locale } from '../i18n';

type Props = {
	title?: string;
	description?: string;
	locale?: Locale;
	/** Off for pages that exist in one language only, so they claim no alternates. */
	translated?: boolean;
	/** The 404 page is also reachable at /404/, where it answers 200 and would be indexable. */
	noindex?: boolean;
};

const {
	title = 'Manuel Veigel | Software Developer',
	description = 'Portfolio of Manuel Veigel, a software developer building clean and useful digital products.',
	locale = defaultLocale,
	translated = true,
	noindex = false,
} = Astro.props;

const t = ui[locale];

// Routes build to directory format, and GitHub Pages 301s the slashless form to
// the trailing-slash one. That redirect target is the URL to declare, here and
// in the sitemap, so nothing points a search engine at a redirect.
const withTrailingSlash = (path: string) => (path.endsWith('/') ? path : `${path}/`);

const normalizedPath = withTrailingSlash(Astro.url.pathname);
const canonical = new URL(normalizedPath, Astro.site);

const alternateFor = (alternateLocale: Locale) =>
	new URL(withTrailingSlash(localePath(alternateLocale, stripLocaleFromPathname(normalizedPath))), Astro.site).href;

const alternates = translated
	? locales.map((alternateLocale) => ({ locale: alternateLocale, href: alternateFor(alternateLocale) }))
	: [];

// This page's path in every locale, for the language redirect in the head.
// Paths rather than the full URLs above, so it also works off the live domain.
const localePaths = Object.fromEntries(
	locales.map((pathLocale) => [pathLocale, withTrailingSlash(localePath(pathLocale, stripLocaleFromPathname(normalizedPath)))]),
);

/*
 * public/og.jpg is the social preview card: name, role and the avatar on the
 * hero's blueprint grid, at the 1.91:1 social platforms expect. It is rendered
 * from scripts/og/og.html and checked in; that file says how to regenerate it,
 * which is needed whenever the avatar or the name/role on it change.
 */
const ogImageUrl = new URL('/og.jpg', Astro.site);
const ogImageSize = { width: 1200, height: 630 };

const ogLocales: Record<Locale, string> = { en: 'en_US', de: 'de_AT' };
---

<!doctype html>
<html lang={htmlLang[locale]} data-theme="portfolio">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!--
			Language on arrival. GitHub Pages can't negotiate it server-side, so this
			runs first thing in the head and swaps to the page's other language when
			that fits the visitor better: German if German comes before English in
			the browser's languages, English otherwise. A language picked in the
			header is remembered and always wins, and moving around the site itself
			never redirects. Pages in one language only have nothing to swap to.
		-->
		{
			translated && (
				<script is:inline define:vars={{ locale, localePaths }}>
					try {
						const cameFromSite = document.referrer && new URL(document.referrer).origin === location.origin;
						if (!cameFromSite) {
							const chosen = localStorage.getItem('locale');
							const preferred = (navigator.languages?.length ? navigator.languages : [navigator.language])
								.map((language) => language.toLowerCase().split('-')[0])
								.find((language) => language in localePaths);
							const wanted = chosen in localePaths ? chosen : preferred === 'de' ? 'de' : 'en';
							if (wanted !== locale) location.replace(localePaths[wanted] + location.search + location.hash);
						}
					} catch {
						// Storage or referrer unavailable: stay on the page as requested.
					}
				</script>
			)
		}

		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#f4f6f9" />
		{noindex && <meta name="robots" content="noindex" />}

		<link rel="canonical" href={canonical.href} />
		{alternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
		{translated && <link rel="alternate" hreflang="x-default" href={alternateFor(defaultLocale)} />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Manuel Veigel" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:image" content={ogImageUrl.href} />
		<meta property="og:image:width" content={String(ogImageSize.width)} />
		<meta property="og:image:height" content={String(ogImageSize.height)} />
		<meta property="og:image:alt" content={t.meta.ogImageAlt} />
		<meta property="og:locale" content={ogLocales[locale]} />
		{
			locales
				.filter((alternateLocale) => translated && alternateLocale !== locale)
				.map((alternateLocale) => <meta property="og:locale:alternate" content={ogLocales[alternateLocale]} />)
		}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl.href} />

		<link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="preload" href="/fonts/source-serif-4-var-latin.woff2" as="font" type="font/woff2" crossorigin />

		<title>{title}</title>

		<!-- Runs before first paint. Entrance animations hide their targets only
		     under `.js`, so without script (or if this never runs) everything is
		     simply visible. -->
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
	</head>
	<body class="bg-base-100 text-base-content">
		<a class="skip-link" href="#content">{t.nav.skip}</a>
		<slot />
		<Reveal />
	</body>
</html>
